# ==============================================================================
# CAR DELIGHTS — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the secrets for your deployment.
# NEVER commit your real .env file to source control.

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
# Generate a new key using: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-cryptographically-secure-random-50-character-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=cardelights.com,www.cardelights.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://cardelights.com,https://www.cardelights.com

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL recommended for production)
# ------------------------------------------------------------------------------
# Examples:
#   PostgreSQL: postgres://cardelights_user:strong_password@db:5432/cardelights_db
#   SQLite (fallback): sqlite:///db.sqlite3
DATABASE_URL=postgres://cardelights:cardelights_secure_pass_2026@db:5432/cardelights_db

# Credentials for Docker PostgreSQL service
POSTGRES_DB=cardelights_db
POSTGRES_USER=cardelights
POSTGRES_PASSWORD=cardelights_secure_pass_2026
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Cache & Sessions (Redis)
# ------------------------------------------------------------------------------
# Leave blank or omit to use Django's local memory / database cache fallback
REDIS_URL=redis://redis:6379/1

# ------------------------------------------------------------------------------
# 4. HTTPS & Security Settings
# ------------------------------------------------------------------------------
# Set to True if SSL is terminated directly on Django or forwarded by reverse proxy
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security (HSTS) - Recommended: 31536000 (1 year)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# 5. Static & Media Asset Storage
# ------------------------------------------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/
